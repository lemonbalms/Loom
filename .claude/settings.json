{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-agent-model.ts\""
          },
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/scripts/rule-router-jit.ts\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-bun-test-env.ts\""
          },
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/scripts/rule-router-jit.ts\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/scripts/session-context.ts\" --part all",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/scripts/norms-receipt.ts\" --format claude-json",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
